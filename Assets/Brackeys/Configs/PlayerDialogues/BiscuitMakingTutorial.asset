%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a740502731dab025bdeccf416ca83a4, type: 3}
  m_Name: BiscuitMakingTutorial
  m_EditorClassIdentifier: 
  <ShouldBlockInteraction>k__BackingField: 1
  <ShouldBeSkippable>k__BackingField: 1
  <ChainType>k__BackingField: 3
  <Dialogues>k__BackingField:
  - <Message>k__BackingField: "Welcome to the bakery! It\u2019s time to start making
      biscuits! Hit the corresponding key on your keyboard at the right time to start
      making a batch of biscuits."
    <IconOverride>k__BackingField: {fileID: 21300000, guid: 12271be7b6dbe0943b30a3c458b60890, type: 3}
  - <Message>k__BackingField: You make biscuits in batches, needing 10 correct hits
      to make a batch. At first, a single batch will only get you 5 biscuits.
    <IconOverride>k__BackingField: {fileID: 21300000, guid: b691d168a133df34685b6481b536ce4e, type: 3}
  - <Message>k__BackingField: "As you get hits and perfect hits, you\u2019ll start
      increasing your multiplier. At a 2x mult, each batch will create 10 biscuits,
      and so on."
    <IconOverride>k__BackingField: {fileID: 21300000, guid: 1229d9a81f257254d9cb2e43ecd8b7b8, type: 3}
  - <Message>k__BackingField: "To start, there\u2019s a limit to how many biscuits
      you can hold on to at a given time. If you click on the upgrade button below
      the bakery, you can pay to increase your limit as well as increase your starting
      multiplier."
    <IconOverride>k__BackingField: {fileID: 21300000, guid: b691d168a133df34685b6481b536ce4e, type: 3}
