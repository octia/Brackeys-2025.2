MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a740502731dab025bdeccf416ca83a4, type: 3}
  m_Name: InitialTutorial
  m_EditorClassIdentifier: 
  <ShouldBlockInteraction>k__BackingField: 0
  <ShouldBeSkippable>k__BackingField: 1
  <ChainType>k__BackingField: 1
  <Dialogues>k__BackingField:
  - <Message>k__BackingField: "Your biscuits are at risk because hungry dogs are
      coming to eat them! You\u2019ve got to build some towers to defend your bakery."
    <IconOverride>k__BackingField: {fileID: 0}
  - <Message>k__BackingField: "You can spend biscuits on a variety of things, including
      buying new towers. But be careful! Biscuits are also your health - when you
      run out of biscuits, it\u2019s game over!"
    <IconOverride>k__BackingField: {fileID: 0}
  - <Message>k__BackingField: Head over to one of the YELLOW BLOCKS (CHANGE) and
      press space to open up the tower options. The GRAY BLOCKS (CHANGE) are locations
      you can build a tower if you pay to unlock them first.
    <IconOverride>k__BackingField: {fileID: 0}
  - <Message>k__BackingField: If you ever need to make more biscuits, you can head
      down to the bakery in the bottom left and hit space.
    <IconOverride>k__BackingField: {fileID: 0}
